model Instance {
  id                String   @id @default(cuid())
  name              String   @unique
  status            String   @default("connecting") // connecting | open | disconnected
  provider          String   @default("baileys") // baileys | meta_cloud | evolution | whatsmeow
  phoneNumberId     String?
  whatsappBusinessAccountId String?
  displayPhoneNumber String?
  metaApiVersion    String?
  proxyPool         String?  // JSON.stringify(string[])
  proxyUrl          String?  // @deprecated - campo legado
  antibotConfig     String?  // JSON.stringify(AntibotConfig)
  metaSendControls  String?  // JSON.stringify(MetaSendControls)
  metaTemplates     String?  // cache JSON do catálogo da WABA
  metaTemplatesSyncedAt DateTime?
  metaWebhookDiagnostic String? // JSON sem payload do último webhook autenticado
  agentEnabled      Boolean  @default(false) // opt-in explícito para respostas automáticas
  specialistId      String?  // especialista vinculado; o WhatsApp só faz o tráfego
  agentBehavior     String?  // JSON.stringify({ accumulationSeconds, responseDelaySeconds })
  agentIdentity     String?  // JSON.stringify({ businessName, humanChannel })
  agentPausedReason String?
  evolutionBaseUrl  String?
  evolutionApiKey   String?  // segredo: nunca exposto por rotas/views
  evolutionQrCode   String?
  evolutionWebhookUrl String?
  evolutionWebhookSecret String? // segredo de autenticação da URL do webhook
  evolutionLastError String?

  createdAt         DateTime @default(now())

  // Relações
  conversations     Conversation[]
  messages          Message[]
  contacts          Contact[]
  deliveryIntents   DeliveryIntent[]
  // ⚠️ Removido "campaigns Campaign[]": não existe FK real aqui.
  // A ligação campanha↔instâncias é feita via Campaign.instanceIds
  // (JSON.stringify(string[])), consumida manualmente em
  // core/campaignEngine.js — não é uma relação Prisma. Declarar esse
  // campo sem contraparte em Campaign quebra "prisma generate".

  @@map("instances")
}

model DeliveryIntent {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  source             String
  campaignId         String?
  recipientId        String?
  sourceMessageId    String?
  instanceId         String
  recipientNumber    String
  recipientVariables String   @default("{}")
  message            String
  status             String   @default("pending_approval")
  approvedBy         String?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  provider           String?
  providerMessageId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  audits   DeliveryAudit[]

  @@index([status, createdAt])
  @@index([instanceId, status])
  @@map("delivery_intents")
}

model DeliveryAudit {
  id               String   @id @default(cuid())
  deliveryIntentId String
  action           String
  actor            String
  details          String   @default("{}")
  createdAt        DateTime @default(now())

  deliveryIntent DeliveryIntent @relation(fields: [deliveryIntentId], references: [id], onDelete: Cascade)

  @@index([deliveryIntentId, createdAt])
  @@map("delivery_audits")
}

model Conversation {
  id                      String    @id @default(cuid())
  instanceId              String
  contactJid              String    // ex: 5511999999999@s.whatsapp.net
  contactName             String?
  unreadCount             Int       @default(0)
  lastMessagePreview      String?
  lastMessageAt           DateTime?
  agentPaused             Boolean   @default(false)
  agentPauseReason        String?
  agentOptedOutAt         DateTime?
  agentHandoffAt          DateTime?

  // Relações
  instance  Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
  @@unique([instanceId, contactJid]) // evita duplicar a conversa em corrida de mensagens simultâneas
  @@index([instanceId, contactJid])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  instanceId     String
  direction      String    // in | out
  authorType     String    // contact | human | agent
  automationId   String?   // identificador do Flow para contabilizar respostas automáticas
  text           String?
  mediaType      String?   // ex: image/jpeg
  mediaUrl       String?   // nome do arquivo
  templateName   String?   // nome do template oficial Meta, quando aplicável
  templateLanguageCode String?
  templateComponents String? // JSON dos parâmetros originais, usado somente no reenvio oficial
  waMessageId    String?
  status         String?   // pending_approval | sending | sent | delivered | read | failed
  deliveryIntentId String?
  providerStatus String?
  providerErrorCode String?
  statusUpdatedAt DateTime?
  error          String?   // presente quando status === 'failed'
  timestamp      DateTime  @default(now())

  // Relações
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  instance     Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("messages")
  @@index([conversationId])
  @@index([instanceId])
}

model Campaign {
  id              String   @id @default(cuid())
  name            String
  localAccess     Boolean  @default(false)
  templateContent String   // texto com placeholders {{coluna}}
  campaignType    String   @default("baileys_text") // baileys_text | meta_template
  metaTemplate    String?  // JSON.stringify({ name, languageCode, variableSources }) (variableKeys legado)
  estimatedSpend  Float?
  instanceIds     String   // JSON.stringify(string[]) — NÃO é FK, ver nota em Instance
  minDelay        Float    @default(3)  // minutos
  maxDelay        Float    @default(3)  // minutos
  status          String   @default("draft") // draft | running | paused | completed | cancelled

  // Relações
  recipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id                  String    @id @default(cuid())
  campaignId          String
  number              String    // apenas dígitos
  variables           String?   // JSON.stringify(linha CSV)
  status              String    @default("pending") // pending | sent | failed
  providerMessageId   String?
  providerStatus      String?
  providerErrorCode   String?
  assignedInstanceId  String?
  sentAt              DateTime?
  error               String?

  // Relações
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_recipients")
  @@index([campaignId, status])
}

model Contact {
  id         String   @id @default(cuid())
  instanceId String
  number     String   // apenas dígitos, com DDI (ex: 5511999999999)
  name       String
  role       String?  // cargo livre, ex: "Dono", "Gerente", "Atendente"
  isOwner    Boolean  @default(false) // no máx. 1 por instância — quem recebe whatsappNotifyOwner

  createdAt  DateTime @default(now())

  // Relações
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("contacts")
  @@unique([instanceId, number])
  @@index([instanceId])
}

model AgentConsultation {
  id                   String   @id @default(cuid())
  instanceId           String
  sourceConversationId String
  sourceMessageId      String?
  helperConversationId String
  helperContactJid     String
  question             String
  status               String   @default("pending") // pending | answered | cancelled
  helperAnswer         String?
  answeredAt           DateTime?
  createdAt            DateTime @default(now())

  @@index([helperConversationId, status])
  @@index([sourceConversationId, status])
  @@map("agent_consultations")
}

model AgentKnowledge {
  id             String   @id @default(cuid())
  instanceId     String
  consultationId String?  @unique
  question       String
  answer         String
  createdAt      DateTime @default(now())

  @@index([instanceId, createdAt])
  @@map("agent_knowledge")
}
